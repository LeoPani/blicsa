    given-names: "Leonardo"
version: "2.0.0"
date-released: "2026-08-04"
license: MIT
url: "https://github.com/LeoPani/blicsa"
repository-code: "https://github.com/LeoPani/blicsa"
keywords:
  - bibliometrics
  - scientometrics
  - science mapping
  - network analysis
  - co-word analysis
  - OpenAlex
