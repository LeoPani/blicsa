cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: "Blicsa"
abstract: >-
  Desktop application for bibliometric analysis: literature search across OpenAlex, Crossref
  and PubMed, corpus building, co-occurrence knowledge maps (network, overlay and density),
  and bibliometric statistics. Local-first: the corpus never leaves the user's machine.
authors:
  - family-names: "Paniago"
    given-names: "Leonardo Luiz Costa"
    orcid: "https://orcid.org/0009-0006-1663-3349"
contact:
  - family-names: "Paniago"
    given-names: "Leonardo Luiz Costa"
    email: "blicsa.app@gmail.com"
version: "2.1.0-beta.3"
date-released: "2026-09-25"
license: MIT
url: "https://github.com/LeoPani/blicsa"
repository-code: "https://github.com/LeoPani/blicsa"
identifiers:
  # DOI de conceito: resolve sempre para a versão mais recente. É o que envelhece bem e
  # o que aparece no badge do README.
  - type: doi
    value: "10.5281/zenodo.21866410"
    description: "DOI de conceito — todas as versões do Blicsa no Zenodo"
  # DOI da versão estável anterior: congelado na v2.0.0. A beta atual ainda não possui
  # DOI próprio; o DOI de conceito acima mantém a continuidade do projeto.
  - type: doi
    value: "10.5281/zenodo.21866411"
    description: "Snapshot permanente da v2.0.0 no Zenodo"
keywords:
  - bibliometrics
  - scientometrics
  - science mapping
  - network analysis
  - co-word analysis
  - OpenAlex
