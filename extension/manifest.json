{
  "manifest_version": 3,
  "name": "Blicsa Browser Extension",
  "version": "1.0",
  "description": "Browser extension to easily add papers to Blicsa active corpus.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://localhost:8765/*",
    "http://localhost:8766/*",
    "http://localhost:8767/*",
    "http://localhost:8768/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "blicsa@leopani.dev",
      "strict_min_version": "115.0"
    }
  }
}
